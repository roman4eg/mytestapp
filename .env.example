# API Keys Configuration
# Copy this file to .env and add your actual API keys

# Opinion API Key
# Get your key from: https://opinion.trade (request via email)
OPINION_API_KEY=your_opinion_api_key_here

# Kalshi API Key (optional - only if you get 403 errors)
# Get your key from: https://kalshi.com → Settings → API Keys
KALSHI_API_KEY=your_kalshi_api_key_here
